[{"id": 0, "text": "活動情報、主辦方研究、歷屆得獎模式、訪談方向與致勝策略"}, {"id": 1, "text": "核心結論："}, {"id": 2, "text": "最有勝算的作品不是技術最複雜，而是能證明一個真實、狹窄問題，完成可操作的"}, {"id": 3, "text": "工作流程，並同時說清楚社會成果、安全界線與落地模式。"}, {"id": 4, "text": "研究日期："}, {"id": 5, "text": "年"}, {"id": 6, "text": "月"}, {"id": 7, "text": "日"}, {"id": 8, "text": "活動日期："}, {"id": 9, "text": "團隊："}, {"id": 10, "text": "目錄與使用方式"}, {"id": 11, "text": "本文件整合截至"}, {"id": 12, "text": "日的公開資料與"}, {"id": 13, "text": "唯讀調查。"}, {"id": 14, "text": "內容分為已確認事實、研究推論與未確認事項。主辦方及評審背景屬於公開紀錄推論，不能視為正式評分標準。"}, {"id": 15, "text": "活動正式資訊與賽前準備"}, {"id": 16, "text": "主"}, {"id": 17, "text": "辦人與主辦組織"}, {"id": 18, "text": "合"}, {"id": 19, "text": "作單位與生態系"}, {"id": 20, "text": "類"}, {"id": 21, "text": "似比賽與歷屆得獎作品"}, {"id": 22, "text": "澳洲問題導向的訪談領域"}, {"id": 23, "text": "三"}, {"id": 24, "text": "人團隊的致勝策略"}, {"id": 25, "text": "研"}, {"id": 26, "text": "究限制、待確認事項與來源"}, {"id": 27, "text": "1. 活動正式資訊與賽前準備"}, {"id": 28, "text": "項目"}, {"id": 29, "text": "已確認資訊"}, {"id": 30, "text": "活動"}, {"id": 31, "text": "時間"}, {"id": 32, "text": "（一）"}, {"id": 33, "text": "至"}, {"id": 34, "text": "（二）"}, {"id": 35, "text": "；兩天皆"}, {"id": 36, "text": "地點"}, {"id": 37, "text": "主辦"}, {"id": 38, "text": "與"}, {"id": 39, "text": "：提出問題／構想、接受導師回饋、壓力測試需求、形成隊伍並開始建置"}, {"id": 40, "text": "：完成"}, {"id": 41, "text": "向全場"}, {"id": 42, "text": "團隊規模"}, {"id": 43, "text": "可自行組隊；官方建議"}, {"id": 44, "text": "人"}, {"id": 45, "text": "正式評估語言"}, {"id": 46, "text": "；未公布權重"}, {"id": 47, "text": "由開發團隊保有；合作單位不會自動取得權利"}, {"id": 48, "text": "餐食"}, {"id": 49, "text": "不供應午餐；附近餐廳有折扣"}]